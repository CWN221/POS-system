# PostgreSQL connection string for the POS database
# Example: Host=localhost;Port=5432;Database=supermarket_pos;Username=postgres;Password=yourpassword
POS_DB_CONNECTION=Host=localhost;Port=5432;Database=supermarket_pos;Username=postgres;Password=yourpassword

# Which cloud provider to use: "supabase" or "azure"
CLOUD_PROVIDER=
CLOUD_ENABLED=true
CLOUD_SUPABASE_CONNECTION=Host=;Port=5432;Database=postgres;Username=yourusername;Password=yourpassword;SSL Mode=Require;Trust Server Certificate=true
CLOUD_AZURE_CONNECTION=Host=;Port=5432;Database=postgres;Username=yourusername;Password=yourpassword;SSL Mode=Require
CLOUD_SYNC_INTERVAL_MINUTES=5
# Branch identifier — must match a branch Id in your local DB
LOCAL_BRANCH_ID=1


# M-Pesa API credentials
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=your_key
MPESA_CONSUMER_SECRET=your_secret
MPESA_PASSKEY=your_passkey
MPESA_SHORTCODE=174379
MPESA_CALLBACK_URL=https://your-ngrok-or-host/callback